# Servicios externos opcionales (copia este archivo como .env.local para cambiarlos).
# Servidor OSRM con perfil peatonal para las rutas a pie:
VITE_ROUTING_URL=https://routing.openstreetmap.de/routed-foot
# Teselas del mapa base ({z}/{x}/{y} coordenadas; {s} subdominio y {r} @2x son opcionales):
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Base de datos en la nube (Supabase). Si se dejan vacías, todo se guarda en el navegador.
# Usa la clave pública (sb_publishable_...). Nunca pongas aquí la clave secreta.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
